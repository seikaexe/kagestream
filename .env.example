# ---------------------------------------------------------------------------
# Kagenime environment configuration
# Copy this file to .env.local and adjust when needed.
# All values are optional; the defaults below are used when unset.
# ---------------------------------------------------------------------------

# Animein API proxy base used by the Animein adapter.
# The public website exposes this proxy; do not point it at an authenticated API.
ANIMEIN_API_BASE=https://animeinweb.com/api/proxy
ANIMEIN_API_SECRET=animein-secure-proxy-key-123

# AniList GraphQL endpoint (official public API)
ANILIST_API_URL=https://graphql.anilist.co

# AniSkip public API
ANISKIP_API_URL=https://api.aniskip.com

# MangaDex official API. Some networks block this host; the app degrades
# gracefully and other manga sources remain available.
MANGADEX_API_URL=https://api.mangadex.org

# Shinigami API
SHINIGAMI_API_URL=https://api.shinigami.io/v1

# Komiku website
KOMIKU_BASE_URL=https://komiku.org

# WEBTOON website (Indonesian section)
WEBTOON_BASE_URL=https://www.webtoons.com/id

# Server-side request timeout in milliseconds
SOURCE_TIMEOUT_MS=15000

# Cache TTL in seconds for external responses
CACHE_TTL_SECONDS=300
